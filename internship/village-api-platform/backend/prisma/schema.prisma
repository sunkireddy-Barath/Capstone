generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ─── Geography Hierarchy ──────────────────────────────────────────────────────

model Country {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique @db.VarChar(10)
  states    State[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("countries")
}

model State {
  id         Int               @id @default(autoincrement())
  code       String            @unique @db.VarChar(10)
  name       String            @db.VarChar(100)
  countryId  Int
  country    Country           @relation(fields: [countryId], references: [id], onDelete: Restrict)
  districts  District[]
  userAccess UserStateAccess[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([countryId])
  @@index([name])
  @@map("states")
}

model District {
  id           Int           @id @default(autoincrement())
  code         String        @db.VarChar(10)
  name         String        @db.VarChar(150)
  stateId      Int
  state        State         @relation(fields: [stateId], references: [id], onDelete: Restrict)
  subDistricts SubDistrict[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([code, stateId])
  @@index([stateId])
  @@index([name])
  @@map("districts")
}

model SubDistrict {
  id         Int       @id @default(autoincrement())
  code       String    @db.VarChar(10)
  name       String    @db.VarChar(150)
  districtId Int
  district   District  @relation(fields: [districtId], references: [id], onDelete: Restrict)
  villages   Village[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([code, districtId])
  @@index([districtId])
  @@index([name])
  @@map("sub_districts")
}

model Village {
  id            Int         @id @default(autoincrement())
  code          String      @db.VarChar(15)
  name          String      @db.VarChar(200)
  subDistrictId Int
  subDistrict   SubDistrict @relation(fields: [subDistrictId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([code, subDistrictId])
  @@index([subDistrictId])
  @@index([name])
  @@map("villages")
}

// ─── Users & Plans ────────────────────────────────────────────────────────────

enum PlanType {
  FREE
  PREMIUM
  PRO
  UNLIMITED
}

enum UserRole {
  ADMIN
  CLIENT
}

model User {
  id          Int               @id @default(autoincrement())
  email       String            @unique @db.VarChar(255)
  password    String
  name        String            @db.VarChar(150)
  company     String?           @db.VarChar(200)
  role        UserRole          @default(CLIENT)
  planType    PlanType          @default(FREE)
  isActive    Boolean           @default(true)
  apiKeys     ApiKey[]
  apiLogs     ApiLog[]
  stateAccess UserStateAccess[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([email])
  @@index([role])
  @@index([planType])
  @@map("users")
}

// ─── API Key Management ───────────────────────────────────────────────────────

model ApiKey {
  id         Int       @id @default(autoincrement())
  key        String    @unique @db.VarChar(64)
  secretHash String
  name       String    @db.VarChar(100)
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive   Boolean   @default(true)
  dailyLimit Int       @default(1000)
  apiLogs    ApiLog[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([key])
  @@index([userId])
  @@map("api_keys")
}

// ─── Access Control ───────────────────────────────────────────────────────────

model UserStateAccess {
  id        Int      @id @default(autoincrement())
  userId    Int
  stateId   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, stateId])
  @@index([userId])
  @@map("user_state_access")
}

// ─── API Logging ──────────────────────────────────────────────────────────────

model ApiLog {
  id           Int      @id @default(autoincrement())
  apiKeyId     Int?
  userId       Int?
  endpoint     String   @db.VarChar(500)
  method       String   @db.VarChar(10)
  statusCode   Int
  responseTime Int
  ipAddress    String?  @db.VarChar(45)
  userAgent    String?  @db.VarChar(500)
  cacheHit     Boolean  @default(false)
  apiKey       ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([apiKeyId])
  @@index([userId])
  @@index([createdAt])
  @@index([statusCode])
  @@map("api_logs")
}
