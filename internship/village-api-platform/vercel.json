{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["backend/prisma/**"]
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/health",       "dest": "backend/src/app.js" },
    { "src": "/ready",        "dest": "backend/src/app.js" },
    { "src": "/api/(.*)",     "dest": "backend/src/app.js" },
    { "src": "^/assets/(.*)", "dest": "frontend/dist/assets/$1" },
    { "src": "/(.*\\.(js|css|svg|ico|png|woff2?)$)", "dest": "frontend/dist/$1" },
    { "src": "/(.*)",         "dest": "frontend/dist/index.html" }
  ]
}
