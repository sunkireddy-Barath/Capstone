# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ─── Database (NeonDB / PostgreSQL) ──────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="generate-with-openssl-rand-base64-64"
JWT_REFRESH_SECRET="generate-with-openssl-rand-base64-64"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Security ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
CORS_ORIGIN="https://your-frontend-domain.vercel.app"

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=86400000
FREE_DAILY_LIMIT=1000
PREMIUM_DAILY_LIMIT=10000
PRO_DAILY_LIMIT=100000
UNLIMITED_DAILY_LIMIT=999999999

# ─── Cache TTLs (seconds) ────────────────────────────────────────────────────
CACHE_TTL_STATES=3600
CACHE_TTL_DISTRICTS=3600
CACHE_TTL_SUBDISTRICTS=1800
CACHE_TTL_VILLAGES=900
CACHE_TTL_SEARCH=300
CACHE_TTL_AUTOCOMPLETE=300
CACHE_TTL_APIKEY=86400
